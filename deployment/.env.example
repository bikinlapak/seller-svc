# Local stack settings. Copy to deployment/.env (git-ignored) and adjust;
# docker compose reads it automatically. Every value has a working default,
# so the stack also runs with no .env at all.

# Host ports.
APP_PORT=3000
SVC_PORT=8080

# worksh.io GraphQL, reached from inside the container.
SELLER_SVC_WORKS_GRAPHQL_URL=http://host.docker.internal:8000/graphql

# Ed25519 private key for action tokens (PKCS#8 DER, base64). Empty = a
# throwaway key per start: tokens die on restart. Fine locally, never in prod.
# Generate: openssl genpkey -algorithm ed25519 -outform DER | base64
SELLER_SVC_ACTION_KEY=

# Gemini (vision, understanding questions, translation, menu ideas). Off by
# default: everything then runs on rules, templates and stand-ins, at no cost.
#
# Vertex AI, no key: set the project, then once on this machine run
#   gcloud auth application-default login
# Those credentials are mounted read-only from GCLOUD_CONFIG_DIR.
SELLER_SVC_VERTEX_PROJECT=
SELLER_SVC_VERTEX_LOCATION=global
GCLOUD_CONFIG_DIR=~/.config/gcloud
# Or the Gemini API with a key (takes precedence over Vertex).
SELLER_SVC_GEMINI_API_KEY=
# The cheap tier; flash-lite models are served on the `global` location.
SELLER_SVC_GEMINI_MODEL=gemini-3.5-flash-lite
# Model calls per day before falling back to rules and templates.
SELLER_SVC_GEMINI_DAILY_CAP=2000

RUST_LOG=seller_svc=debug,tower_http=info

# Run seller-app on fixtures, without seller-svc data.
SELLER_SVC_MOCK=false

# 1 = Caddy logs every request with headers.
LOG_REQUESTS=0
