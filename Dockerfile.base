# Runtime base image, built once and pushed to Artifact Registry.
# App images FROM it, so a deploy never runs apt again. Rebuild only on
# OS/library changes, then bump the tag (BASE_IMAGE in deploy.yml / Makefile).
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean
