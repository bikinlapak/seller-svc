SELLER_SVC_BIND_ADDR=127.0.0.1:8080
SELLER_SVC_LOG_JSON=false
SELLER_SVC_WORKS_GRAPHQL_URL=http://127.0.0.1:8000/graphql
# Dipisah koma. Default: dev server seller-app.
SELLER_SVC_CORS_ORIGINS=http://localhost:5173

# Kunci privat Ed25519 (PKCS#8 DER, base64) untuk menandatangani token aksi.
# Kosong = kunci sementara dibuat saat start, dan semua token hangus setiap
# restart. Cukup untuk dev; di staging/produksi isi dari Secret Manager.
# Bikin satu:
#   openssl genpkey -algorithm ed25519 -outform DER | base64
SELLER_SVC_ACTION_KEY=

RUST_LOG=seller_svc=debug,tower_http=info

# Gemini: waste-photo vision, understanding questions, translation into the
# merchant's language, menu ideas. Off when both are empty (rules, templates
# and stand-ins, no cost). Vertex needs `gcloud auth application-default
# login` locally; on Cloud Run it uses the runtime service account.
SELLER_SVC_VERTEX_PROJECT=
SELLER_SVC_VERTEX_LOCATION=global
SELLER_SVC_GEMINI_API_KEY=
SELLER_SVC_GEMINI_MODEL=gemini-3.5-flash-lite
SELLER_SVC_GEMINI_DAILY_CAP=2000
