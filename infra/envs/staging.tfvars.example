# Copy to staging.tfvars and adjust. staging.tfvars is not committed.
project_id        = "passtok-staging"
env               = "staging"
region            = "asia-southeast2"
works_graphql_url = "https://staging.worksh.io/graphql"
github_owner      = "bikinlapak"

# The demo needs seller-svc to stay warm; outside that keep it at 0.
min_instances_svc = 0
max_instances     = 4
